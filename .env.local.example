# TMDB API (https://www.themoviedb.org/settings/api)
# v4 auth "Read Access Token" — used as a Bearer token, not the v3 "API Key".
TMDB_API_READ_ACCESS_TOKEN=

# Region used for /watch/providers filtering (ISO 3166-1 code)
TMDB_WATCH_REGION=US

# Google AI Studio key for vibe search (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# MongoDB Atlas connection string
MONGODB_URI=

# Auth.js (Google login). Create the Google OAuth client at https://console.cloud.google.com/apis/credentials
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional: OMDb key for IMDb / Rotten Tomatoes / Metacritic scores (https://www.omdbapi.com/apikey.aspx)
OMDB_API_KEY=

# ElevenLabs (voice search + narration): https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Optional: override the narrator voice
ELEVENLABS_VOICE_ID=

# Tiger Data (TimescaleDB) connection string for trending: https://console.cloud.timescale.com
TIGER_DATABASE_URL=


# DigitalOcean Gradient serverless inference (optional extra model in the refinement chain)
DO_INFERENCE_KEY=
DO_INFERENCE_MODEL=

# Emails (comma-separated) that get an auto-filled presentation dashboard on sign-in
DEMO_ACCOUNT_EMAILS=
